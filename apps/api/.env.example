# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the Next.js web app. The web app proxies /api/* to this API,
# so OAuth callbacks and cookies all live on this domain.
WEB_URL=http://localhost:3000

# PostgreSQL (Neon / Supabase / RDS / local docker). For serverless use the pooled URL.
DATABASE_URL=postgresql://socialhub:socialhub@localhost:5432/socialhub?schema=public

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
# 32-byte key, base64. Used to encrypt social access tokens at rest (AES-256-GCM).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Shared secret for /api/cron/* endpoints (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me-cron-secret
# Run the publish/sync scheduler inside the process (Docker / Render / Railway).
# Leave false on Vercel and use Vercel Cron or an external cron instead.
ENABLE_INTERNAL_SCHEDULER=false

# ─── Beta / staging ──────────────────────────────────────────────────────
# true = every workspace gets the top plan for free (no limits) while you collect feedback.
BETA_ALL_ACCESS=false
# Comma-separated emails of the PostGuru team: they see /admin (feedback, beta testers, deletion requests)
# and receive an email for every feedback item, tester sign-up and deletion request.
ADMIN_EMAILS=

# ─── Company details (footer, privacy policy, terms, GST invoices) ───────
# Must match your GST REG-06 exactly: Meta/LinkedIn/Google reviews compare them.
COMPANY_LEGAL_NAME=PostGuru
COMPANY_ADDRESS=
# State of your GST registration: decides CGST+SGST (same state) vs IGST (other states)
COMPANY_STATE=
COMPANY_GSTIN=
# 998315 = hosting & infrastructure provisioning; 99843 = online information/database access
COMPANY_SAC_CODE=998315
SUPPORT_EMAIL=

# ─── Media storage ───────────────────────────────────────────────────────
# "local" (dev only, files on disk), "s3" (AWS S3, Cloudflare R2, Supabase storage, MinIO…)
# or "blob" (Vercel Blob: set BLOB_READ_WRITE_TOKEN, added automatically when you connect a Blob store)
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects, e.g. https://pub-xxxx.r2.dev or https://bucket.s3.amazonaws.com
S3_PUBLIC_URL=
MAX_UPLOAD_MB=200

# ─── Stripe billing ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# International (USD) monthly prices: Creator $9, Business $29, Agency $79
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ─── Razorpay (India, INR: UPI AutoPay, e-mandates, Indian cards) ───────
# Dashboard → Subscriptions → Plans: create monthly plans (amount incl. 18% GST):
# Creator ₹599+GST = ₹707, Business ₹1,999+GST = ₹2,359, Agency ₹4,999+GST = ₹5,899
# Webhook URL: https://your-domain.com/api/billing/razorpay/webhook
# Events: subscription.activated, subscription.charged, subscription.pending, subscription.halted,
#         subscription.cancelled, subscription.completed, payment.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_CREATOR=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_BUSINESS=

# ─── Meta (Facebook Pages + Instagram Business) ──────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# Compliance callbacks (Facebook Login for Business, Instagram and Threads settings):
#   Deauthorize:          https://your-domain.com/api/compliance/meta/deauthorize
#   Data deletion request: https://your-domain.com/api/compliance/meta/data-deletion
#   Data deletion instructions URL: https://your-domain.com/data-deletion

# Instagram API with Instagram Login (creators: no Facebook Page needed).
# Meta app → Instagram → API setup with Instagram login → "Instagram app ID / secret".
# Redirect: https://your-domain.com/api/integrations/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ─── X (Twitter) ─────────────────────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=

# ─── LinkedIn ────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202605
# Set true only after LinkedIn approves the Community Management API for your app
LINKEDIN_ORGANIZATIONS=false

# ─── Google / YouTube ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Threads — Meta app → Use cases → "Access the Threads API" → Settings (Threads app ID / secret)
# Redirect: https://your-domain.com/api/integrations/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=

# TikTok — developers.tiktok.com → app → Login Kit + Content Posting API
# Redirect: https://your-domain.com/api/integrations/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Pinterest — developers.pinterest.com → My apps
# Redirect: https://your-domain.com/api/integrations/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# true while the app only has Trial access (pins go to the API sandbox)
PINTEREST_SANDBOX=false

# ─── Email (password reset, notifications, weekly report) ────────────────
# Any SMTP provider works (Resend, SendGrid, Postmark, Mailgun, SES, Gmail…).
# When SMTP_HOST is empty, emails are written to the API log instead of being sent.
APP_NAME=PostGuru
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PostGuru <no-reply@example.com>"

# ─── AI Growth Assistant (optional) ─────────────────────────────────────
# Enables AI captions, "make it viral", hooks, AI hashtags, YouTube SEO and content ideas.
# Get a key at https://console.anthropic.com. Without it, scoring/hashtags/insights still work.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
